# Supabase project URL and publishable key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Paystack Inline public key (starts with pk_test_ or pk_live_)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Server-only payment verification credentials. Never use NEXT_PUBLIC_ for either key.
PAYSTACK_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key used to send FRAN6 welcome and order emails. Never use NEXT_PUBLIC_ for this key.
RESEND_API_KEY=
